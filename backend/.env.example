# TradeFlow Environment Configuration Example
# Do not commit real secrets to this file.

# Environment (development, test, production)
TRADEFLOW_ENVIRONMENT=development

# Database connection
TRADEFLOW_DATABASE_URL=sqlite:///./tradeflow.sqlite

# Directory settings
TRADEFLOW_UPLOAD_DIR=./data/uploads
TRADEFLOW_OUTPUT_DIR=./data/outputs
TRADEFLOW_TEMPLATE_ROOT=../templates

# Security & Upload Limits
TRADEFLOW_MAX_UPLOAD_SIZE_MB=50
TRADEFLOW_LOG_LEVEL=INFO

# CORS (Comma separated list for multiple origins)
# Example: TRADEFLOW_CORS_ORIGINS=["http://localhost:5173", "https://tradeflow.example.com"]
TRADEFLOW_CORS_ORIGINS=["*"]
